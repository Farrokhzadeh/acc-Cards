# AccAbad Admin runtime configuration
APP_ENV=production
APP_BASE_URL=https://admin.example.com
APP_VERSION=phase24
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Phase 19 worker scheduler
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=300

# Phase 22 request/security controls. Set TRUST_PROXY_HOPS only when the edge proxy strips inbound forwarding headers.
TRUST_PROXY_HOPS=1
API_RATE_LIMIT_PER_MINUTE=600
API_MUTATION_RATE_LIMIT_PER_MINUTE=120
WEBHOOK_RATE_LIMIT_PER_MINUTE=1200
API_MAX_BODY_BYTES=12582912


# Kripicard provider (Phase 17: read integration + guarded writes + scheduled transaction sync)
KRIPICARD_BASE_URL=https://appapi.kripicard.com
KRIPICARD_REQUEST_TIMEOUT_MS=10000
KRIPICARD_READ_RETRY_COUNT=2
KRIPICARD_READ_RETRY_BASE_MS=250
# Phase 17 scheduled transaction synchronization. Generate with: openssl rand -hex 32
KRIPICARD_TRANSACTION_SYNC_JOB_SECRET=
# How often a successfully synchronized card becomes due again.
KRIPICARD_TRANSACTION_SYNC_INTERVAL_SECONDS=120
# Maximum due cards processed by one job invocation.
KRIPICARD_TRANSACTION_SYNC_BATCH_SIZE=50

# Outlook / Hotmail (Microsoft Graph delegated OAuth)
# Register this exact redirect URI in Microsoft Entra:
#   ${APP_BASE_URL}/api/v1/email/outlook/callback
# For personal Outlook/Hotmail accounts, the default tenant is `consumers`.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=consumers
MICROSOFT_GRAPH_TIMEOUT_MS=10000
# Optional cron-safe hook for POST /api/internal/jobs/outlook-sync. Generate with: openssl rand -hex 32
OUTLOOK_SYNC_JOB_SECRET=

# Gmail (Google OAuth + Gmail API)
# Enable the Gmail API in Google Cloud and register this exact Web redirect URI:
#   ${APP_BASE_URL}/api/v1/email/gmail/callback
# Gmail read access uses the restricted gmail.readonly scope. Production/public OAuth may require Google verification.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_GMAIL_TIMEOUT_MS=10000
# Optional cron-safe hook for POST /api/internal/jobs/gmail-sync. Generate with: openssl rand -hex 32
GMAIL_SYNC_JOB_SECRET=

# Email classification / OTP expiry worker (Phase 9)
# Used by POST /api/internal/jobs/email-classify. Generate with: openssl rand -hex 32
EMAIL_CLASSIFY_JOB_SECRET=

# Telegram bot (Phase 10)
# Create the bot with @BotFather, then configure its token only in the deployment secret environment.
TELEGRAM_BOT_TOKEN=
# Sent by Telegram in X-Telegram-Bot-Api-Secret-Token. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Protects POST /api/internal/jobs/telegram-outbox. Generate with: openssl rand -hex 32
TELEGRAM_OUTBOX_JOB_SECRET=
TELEGRAM_REQUEST_TIMEOUT_MS=10000
TELEGRAM_CALLBACK_TTL_MINUTES=30
TELEGRAM_SUPPORT_MODE_MINUTES=120

# Private funding receipt storage (Phase 13). This path must not be web-served.

# Phase 18 private support attachments
SUPPORT_ATTACHMENTS_STORAGE_DIR=/var/lib/accabad/support-attachments
SUPPORT_ATTACHMENT_MAX_BYTES=10485760
RECEIPTS_STORAGE_DIR=/var/lib/accabad/receipts
RECEIPT_MAX_BYTES=10485760
# Production requires a fail-closed clamd scanner for all private uploads.
RECEIPT_CLAMAV_HOST=clamav
RECEIPT_CLAMAV_PORT=3310
RECEIPT_CLAMAV_TIMEOUT_MS=5000
RECEIPT_REQUIRE_ANTIVIRUS=true

# PostgreSQL. Docker Compose uses DATABASE_HOST=postgres.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=accabad
DATABASE_USER=accabad
# Replace before production. Minimum 12 characters; never commit the real value.
DATABASE_PASSWORD=
DATABASE_SSL_MODE=disable
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Application envelope-encryption key for provider/API/OAuth secrets.
# Generate once with: openssl rand -base64 32
# Back this value up in your secret manager. Changing it without rotating encrypted data will make existing secrets unreadable.
APP_ENCRYPTION_KEY=

# Admin authentication/session controls
ADMIN_SESSION_HOURS=12
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_REAUTH_MINUTES=10
REQUIRE_MFA_FOR_PRIVILEGED_ACTIONS=true
ADMIN_MFA_CHALLENGE_MINUTES=5
ADMIN_LOGIN_RATE_MAX_FAILURES=5
ADMIN_LOGIN_RATE_WINDOW_MINUTES=15

# PostgreSQL container exposure. Keep loopback-only unless you have a specific reason.
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432

# Admin application exposure. Put Nginx/Caddy in front for public TLS.
ACCABAD_BIND_IP=127.0.0.1
ACCABAD_PORT=3000

# Phase 21 host data and backup paths. Use absolute host paths in production.
ACCABAD_DATA_DIR=/var/lib/accabad
BACKUP_LOCAL_DIR=/var/backups/accabad
BACKUP_LOCAL_RETENTION_DAYS=14
# Configure rclone with a MEGA remote, then a crypt remote layered over it.
# Only the crypt remote is accepted here, for example: accabad-mega-crypt:production
BACKUP_RCLONE_DESTINATION=

# Global kill switch for all provider writes. Phase 16 supports guarded createcard and fundcard only through approved/accepted request workflows; deposit creation remains unavailable.
ENABLE_LIVE_PROVIDER_WRITES=false
# Dedicated Phase 6 gate. Requires ENABLE_LIVE_PROVIDER_WRITES=true as well.
ENABLE_KRIPICARD_CARD_STATE_WRITES=false
# Dedicated Phase 15 issuance gate. Requires ENABLE_LIVE_PROVIDER_WRITES=true and recent admin reauthentication.
ENABLE_KRIPICARD_CARD_CREATION=false
# Dedicated Phase 16 funding gate. Requires ENABLE_LIVE_PROVIDER_WRITES=true and recent admin reauthentication.
ENABLE_KRIPICARD_CARD_FUNDING=false
# Deployment hard ceilings for runtime Operations switches.
ENABLE_TELEGRAM_SENDS=true
ENABLE_OUTLOOK_SYNC=true
ENABLE_GMAIL_SYNC=true
# Emergency environment override. When true, the UI cannot disable read-only mode.
FORCE_READ_ONLY_MODE=false
# Phase 24 release lock. While true in production, all mutations and provider/email/Telegram activity are forced off.
PRODUCTION_ROLLOUT_BLOCKED=true
# Set only after every signed rollout gate passes and immediately before the approved maintenance-window opening.
# PRODUCTION_ROLLOUT_AUTHORIZATION=PHASE24_RELEASE_AUTHORIZED
# Only required if ENABLE_LIVE_PROVIDER_WRITES=true:
# LIVE_PROVIDER_WRITE_CONFIRMATION=ACCABAD_LIVE_WRITES_ENABLED

# One-time bootstrap values. Set them only when running `npm run admin:bootstrap`, then remove them.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Super Admin
# BOOTSTRAP_ADMIN_PASSWORD=
