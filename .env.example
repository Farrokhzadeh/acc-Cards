# AccAbad Admin - configuration template.
# Copy to .env and fill in the values marked CHANGE ME (or run ./setup.sh to auto-generate).
#   cp .env.example .env

# "staging" keeps things simple: no forced HTTPS, no ClamAV requirement, panel fully writable.
# Use "production" only if you re-enable ClamAV + HTTPS (see DOCKER-DEPLOY.md).
APP_ENV=staging
APP_BASE_URL=http://localhost:3000
APP_VERSION=phase24
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL. With docker compose, host is the bundled "postgres" service.
# Use a project-specific name so it can't collide with other databases.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=accabad_admin
DATABASE_USER=accabad_admin
DATABASE_PASSWORD=CHANGE_ME_min_12_chars
DATABASE_SSL_MODE=disable

# Encrypts secrets stored in the DB. Generate once and back it up:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# ClamAV is removed in the lean setup, so upload virus scanning is off.
RECEIPT_REQUIRE_ANTIVIRUS=false
RECEIPTS_STORAGE_DIR=/var/lib/accabad/receipts
SUPPORT_ATTACHMENTS_STORAGE_DIR=/var/lib/accabad/support-attachments

# Provider write gates. Leave OFF until you have verified read-only connectivity.
ENABLE_LIVE_PROVIDER_WRITES=false
ENABLE_KRIPICARD_CARD_STATE_WRITES=false
ENABLE_KRIPICARD_CARD_CREATION=false
ENABLE_KRIPICARD_CARD_FUNDING=false

# Kripicard provider
KRIPICARD_BASE_URL=https://appapi.kripicard.com

# Outlook / Hotmail (Microsoft Graph delegated OAuth). Leave blank to disable.
# Register this redirect URI in Microsoft Entra: ${APP_BASE_URL}/api/v1/email/outlook/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=consumers

# Gmail (Google OAuth, gmail.readonly scope). Leave blank to disable.
# Register this Web redirect URI in Google Cloud: ${APP_BASE_URL}/api/v1/email/gmail/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_GMAIL_TIMEOUT_MS=10000
GMAIL_SYNC_JOB_SECRET=

# Telegram bot. Create it with @BotFather. Leave blank to disable.
# TELEGRAM_WEBHOOK_SECRET: generate with `openssl rand -hex 32`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Host paths and exposed ports (loopback-only by default; put a proxy in front).
ACCABAD_DATA_DIR=./runtime-data
ACCABAD_BIND_IP=127.0.0.1
ACCABAD_PORT=3000
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432

# One-time admin bootstrap (only for `npm run admin:bootstrap`):
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
