[Unit]
Description=AccAbad verified database and private-file backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/accabad
EnvironmentFile=/opt/accabad/.env
ExecStart=/opt/accabad/scripts/backup/create-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
